<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Quectel Serial Driver</string>
	<key>CFBundlePackageType</key>
	<string>DEXT</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>OSBundleUsageDescription</key>
	<string>Provides serial ports for the AT command interfaces of Quectel LTE modems.</string>
	<key>OSBundleLibraries</key>
	<dict>
		<key>com.apple.kpi.iokit</key>
		<string>19.0</string>
		<key>com.apple.driver.driverkit.serial</key>
		<string>19.0</string>
	</dict>
	<key>IOKitPersonalities</key>
	<dict>
		<!-- Vendor-specific interfaces with subclass 0 / protocol 0 are the
		     NMEA, AT and modem (PPP) ports on Quectel modules; this is the
		     same rule the Linux "option" driver uses. The DM port (ff/ff/ff)
		     and the network interface are deliberately not matched. -->
		<key>QuectelSerial</key>
		<dict>
			<key>CFBundleIdentifier</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleIdentifierKernel</key>
			<string>com.apple.kpi.iokit</string>
			<key>IOClass</key>
			<string>IOUserService</string>
			<key>IOUserClass</key>
			<string>QuectelSerialInterface</string>
			<key>IOUserServerName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>IOProviderClass</key>
			<string>IOUSBHostInterface</string>
			<key>idVendor</key>
			<integer>11388</integer>
			<key>bInterfaceClass</key>
			<integer>255</integer>
			<key>bInterfaceSubClass</key>
			<integer>0</integer>
			<key>bInterfaceProtocol</key>
			<integer>0</integer>
			<key>PortProperties</key>
			<dict>
				<key>CFBundleIdentifierKernel</key>
				<string>com.apple.driver.driverkit.serial</string>
				<key>IOClass</key>
				<string>IOUserSerial</string>
				<key>IOUserClass</key>
				<string>QuectelSerialPort</string>
				<key>IOUserServerName</key>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
				<key>IOTTYBaseName</key>
				<string>quectel</string>
				<key>HiddenPort</key>
				<false/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
