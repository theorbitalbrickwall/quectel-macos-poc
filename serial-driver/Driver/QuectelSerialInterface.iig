// One instance per vendor-specific serial interface of the modem (NMEA, AT,
// modem/PPP). Owns the USB interface and its bulk pipes, and creates one
// QuectelSerialPort child that publishes the /dev/cu.* node.

#include <DriverKit/IOService.iig>
#include <DriverKit/OSAction.iig>
#include <USBDriverKit/IOUSBHostPipe.iig>

class QuectelSerialInterface : public IOService {
public:
    bool init() override;
    void free() override;
    kern_return_t Start(IOService *provider) override;
    kern_return_t Stop(IOService *provider) override;

    virtual void ReceiveComplete(OSAction *action, IOReturn status,
        uint32_t actualByteCount, uint64_t completionTimestamp)
        TYPE(IOUSBHostPipe::CompleteAsyncIO);
    virtual void TransmitComplete(OSAction *action, IOReturn status,
        uint32_t actualByteCount, uint64_t completionTimestamp)
        TYPE(IOUSBHostPipe::CompleteAsyncIO);

    kern_return_t SetPortActive(bool active) LOCALONLY;
    kern_return_t SetLineState(bool dtr, bool rts) LOCALONLY;
    void PumpTransmit() LOCALONLY;
    uint32_t InterfaceNumber() LOCALONLY;
    bool IsStopping() LOCALONLY;
    kern_return_t SubmitReceive() LOCALONLY;
    void Cleanup() LOCALONLY;
};
